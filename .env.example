# ─── Credenciais da conta Uconnect / Jeep ────────────────────────────────────
UCONNECT_EMAIL=seu_email@exemplo.com
UCONNECT_PASSWORD=sua_senha

# ─── Chaves de API (Gigya / FCA) ─────────────────────────────────────────────
# Obtidas pela engenharia reversa do app Uconnect
GIGYA_API_KEY=
VEHICLES_API_KEY=
AUTH_API_KEY=

# ─── Acesso ao dashboard ─────────────────────────────────────────────────────
# PIN de 4 dígitos pedido ao abrir o dashboard. Em branco = 1234.
# 4 tentativas erradas bloqueiam o IP por 1 min; os bloqueios seguintes
# aumentam (5 min, 15 min, 1 h, 6 h, 24 h).
APP_PIN=

# ─── Autenticação da API (Basic Auth) ────────────────────────────────────────
# Opcional: usuário e senha para clientes externos acessarem /api/* sem o PIN
API_USER=seu_usuario
API_PASSWORD=sua_senha_forte

# Atrás de proxy (Coolify/Traefik, Railway) o IP real vem do X-Forwarded-For.
# Padrão: true em produção. Use false se o app ficar exposto direto, sem proxy.
# TRUST_PROXY=true

# ─── Produção ─────────────────────────────────────────────────────────────────
# NODE_ENV=production          # Railway define automaticamente
# PORT=3000                    # Railway define automaticamente
# ALLOWED_ORIGIN=https://...   # Opcional: restringir CORS a um domínio específico
